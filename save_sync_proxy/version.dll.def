	GetFileVersionInfoSizeExW=GetFileVersionInfoSizeExWFwd @7
	GetFileVersionInfoSizeW=GetFileVersionInfoSizeWFwd @8
	GetFileVersionInfoW=GetFileVersionInfoWFwd @9
	VerFindFileA=VerFindFileAFwd @10
	VerFindFileW=VerFindFileWFwd @11
